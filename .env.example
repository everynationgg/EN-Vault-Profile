# ==========================================
# EN Profile (.env.example)
# Standalone Every Nation GG Profile Customizer
# ==========================================

# Vercel App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (ENOS Central PostgreSQL Instance)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# NextAuth v5 Configuration
AUTH_SECRET="generate-a-strong-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Discord OAuth2 Provider
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
DISCORD_GUILD_ID="your-everynation-discord-guild-id"

# Demo Mode Enabled (Allows testing without Discord & Supabase live connection)
NEXT_PUBLIC_DEMO_MODE="true"
